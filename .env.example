# --- Database (required) ---
# Free Postgres: https://neon.tech (no card needed). Use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (required) ---
# Any long random string. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Web push notifications (optional but recommended) ---
# Generate a pair with: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Cron auth (required if you use the reminder scheduler) ---
# Any long random string. The scheduler must send it as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me-too"

# --- AI progress-photo analysis (optional) ---
# Get a key at https://console.anthropic.com  (pay-as-you-go, cents per photo)
ANTHROPIC_API_KEY=""

# --- Signups ---
# Set to "false" after you have created your account so nobody else can register.
ALLOW_SIGNUP="true"

# Frankie in-app assistant (optional). Values are in Frankie under Keys & settings.
# Publishable key for the Product agent (public, read at build time).
NEXT_PUBLIC_FRANKIE_KEY=""
# Support agent key; the Support agent stays off until this is set.
NEXT_PUBLIC_FRANKIE_KEY_SUPPORT=""
# Docs agent key; the Docs agent stays off until this is set.
NEXT_PUBLIC_FRANKIE_KEY_DOCS=""
# Server only: signs the user tokens Frankie verifies. Never give it a NEXT_PUBLIC_ prefix.
FRANKIE_JWT_SECRET=""
